{
  "name": "ecopulse-server",
  "version": "1.0.0",
  "description": "Backend API for EcoPulse (Lifestyle for Environment)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check-db": "node scripts/checkDb.js",
    "dev:db": "node scripts/devMongo.js",
    "seed": "node scripts/seedActivities.js",
    "test": "node scripts/testActivitiesSuite.js && node scripts/testApiSuite.js",
    "test:activities": "node scripts/testActivitiesSuite.js",
    "test:api": "node scripts/testApiSuite.js",
    "sync:engine": "node ../scripts/syncEngine.js",
    "test:engine-sync": "node ../scripts/checkEngineSync.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.0"
  },
  "keywords": [
    "mission-life",
    "sustainability",
    "geda",
    "carbon-footprint"
  ],
  "license": "ISC"
}
