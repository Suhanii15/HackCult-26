PORT=5000
HOST=0.0.0.0
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/ecopulse?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
CLIENT_URL=*

# EcoPulse OTP Email Delivery (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="EcoPulse" <noreply@ecopulse.gov.in>

# EcoPulse OTP SMS Delivery (e.g. MSG91, Twilio, Fast2SMS)
# SMS_PROVIDER = twilio | fast2sms | msg91
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=ECOPLS
# Twilio (SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# MSG91 (SMS_PROVIDER=msg91, SMS_API_KEY = authkey)
MSG91_TEMPLATE_ID=
