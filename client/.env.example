# Expo API URL Configuration
# 1. Physical Android/iOS device over local Wi-Fi (replace with your laptop's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.0.198:5000/api/v1
#
# 2. Android Emulator (10.0.2.2 routes to host machine):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1
#
# 3. Web or iOS Simulator on same machine:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
#
# Leave EXPO_PUBLIC_API_URL unset to let client/src/services/api.js automatically
# detect your Expo Metro LAN host IP on physical devices or 10.0.2.2 on Android emulators.
